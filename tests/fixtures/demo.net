(export (version "E")
  (design
    (source "demo.kicad_sch")
    (tool "Eeschema 10.0"))
  (components
    (comp (ref "R1") (value "10k")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "R2") (value "10k")
      (libsource (lib "Device") (part "R") (description "Resistor")))
    (comp (ref "D1") (value "LED")
      (libsource (lib "Device") (part "LED") (description "Light emitting diode")))
    (comp (ref "Q1") (value "BC547")
      (libsource (lib "Transistor_BJT") (part "BC547") (description "0.1A Ic, 45V Vce, Small Signal NPN Transistor, TO-92"))
      (property (name "Sim.Device") (value "NPN")))
    (comp (ref "U1") (value "TL081")
      (libsource (lib "Amplifier_Operational") (part "TL081") (description "Single JFET-Input Operational Amplifier, DIP-8/SOIC-8"))))
  (nets
    (net (code "1") (name "VCC")
      (node (ref "R1") (pin "1") (pintype "passive"))
      (node (ref "Q1") (pin "1") (pinfunction "C") (pintype "passive"))
      (node (ref "U1") (pin "7") (pinfunction "V+") (pintype "power_in")))
    (net (code "2") (name "/MID")
      (node (ref "R1") (pin "2") (pintype "passive"))
      (node (ref "R2") (pin "1") (pintype "passive"))
      (node (ref "U1") (pin "3") (pinfunction "+") (pintype "input")))
    (net (code "3") (name "GND")
      (node (ref "R2") (pin "2") (pintype "passive"))
      (node (ref "D1") (pin "1") (pinfunction "K") (pintype "passive"))
      (node (ref "U1") (pin "4") (pinfunction "V-") (pintype "power_in")))
    (net (code "4") (name "/BASE")
      (node (ref "U1") (pin "6") (pintype "output"))
      (node (ref "U1") (pin "2") (pinfunction "-") (pintype "input"))
      (node (ref "Q1") (pin "2") (pinfunction "B") (pintype "input")))
    (net (code "5") (name "/LED")
      (node (ref "Q1") (pin "3") (pinfunction "E") (pintype "passive"))
      (node (ref "D1") (pin "2") (pinfunction "A") (pintype "passive")))
    (net (code "6") (name "unconnected-(U1-NULL-Pad1)")
      (node (ref "U1") (pin "1") (pinfunction "NULL") (pintype "input+no_connect")))
    (net (code "7") (name "unconnected-(U1-NULL-Pad5)")
      (node (ref "U1") (pin "5") (pinfunction "NULL") (pintype "input+no_connect")))
    (net (code "8") (name "unconnected-(U1-NC-Pad8)")
      (node (ref "U1") (pin "8") (pinfunction "NC") (pintype "no_connect")))))
